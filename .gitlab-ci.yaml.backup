stages:
  - build 
  - update-tag

variables:
  REGISTRY_HOST: 192.168.0.23:5000
  IMAGE_NAME: orderhub-backend
  VALUES_FILE: orderhub/values.yaml

build-backend:
  stage: build
  image: docker:latest
  services:
    - docker:dind
  variables:
    DOCKER_HOST: tcp://docker:2375
  before_script:
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $REGISTRY_HOST 
  script:
    - docker build -t $REGISTRY_HOST/$IMAGE_NAME:$CI_COMMIT_SHA -f orderhub/docker/backend/back orderhub/docker/backend
    - docker push $REGISTRY_HOST/$IMAGE_NAME:$CI_COMMIT_SHA
  rules:
    - changes:
      - orderhub/docker/backend/**/*
      when: always

update-values:
  stage: update-tag
  image: alpine:latest
  before_script:
    - apk add --no-cache git
  script:
    - git config user.name "GitLab CI"
    - git config user.email "ci@gitlab.com"
    - 'sed -i "s|tag:.*|tag: $CI_COMMIT_SHA|" $VALUES_FILE'  
    - git add $VALUES_FILE 
    - git commit -m "Update backend tag to $CI_COMMIT_SHA" || echo "No changes"
    - git push origin HEAD:main
  rules:
    - changes:
        - orderhub/docker/backend/**/*
      when: on_success
  needs: ["build-backend"]  