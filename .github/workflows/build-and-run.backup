name: Build and Push Backend Images

concurrency:
  group: build-backend
  cancel-in-progress: true

on:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  build:
    strategy:
      matrix:
        project:
          - name: orderhub
            context: orderhub/docker/backend
            dockerfile: orderhub/docker/backend/back
            image: 192.168.0.23:5000/orderhub-backend
            values: orderhub/values.yaml
          - name: shopsync
            context: shopsync/docker/backend
            dockerfile: shopsync/docker/backend/back
            image: 192.168.0.23:5000/shopsync-backend
            values: shopsync/values.yaml

    runs-on: self-hosted
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build and push Docker image
        uses: docker/build-push-action@v5
        with:
          context: ${{ matrix.project.context }}
          file: ${{ matrix.project.dockerfile }}
          push: true
          tags: ${{ matrix.project.image }}:${{ github.sha }}

      - name: Update values.yaml with new tag
        run: |
          sed -i "s|tag:.*|tag: ${{ github.sha }}|" ${{ matrix.project.values }}
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add ${{ matrix.project.values }}
          git commit -m "Update ${{ matrix.project.name }} backend tag to ${{ github.sha }}" || true
          git pull --rebase origin main
          git push origin main